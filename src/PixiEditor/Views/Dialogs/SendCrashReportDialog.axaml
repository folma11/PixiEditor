<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogs="clr-namespace:PixiEditor.Views.Dialogs"
        xmlns:localization="clr-namespace:PixiEditor.UI.Common.Localization;assembly=PixiEditor.UI.Common"
        xmlns:ui="clr-namespace:PixiEditor.Extensions.UI;assembly=PixiEditor.Extensions"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PixiEditor.Views.Dialogs.SendCrashReportDialog"
        MinHeight="195" MinWidth="340"
        ExtendClientAreaToDecorationsHint="False"
        Height="220" Width="340"
        localization:Translator.Key="SEND_CRASH_REPORT_TITLE">
    <StackPanel Margin="10">
        <TextBlock localization:Translator.Key="CRASH_REPORT_LOCATION_INFO" />
        <StackPanel Margin="0 10" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Width="140" Click="OpenInExplorer" localization:Translator.Key="OPEN_IN_FILE_EXPLORER" />
        </StackPanel>
        <TextBlock TextAlignment="Center" localization:Translator.Key="CRASH_REPORT_SEND_INFO" />
        <StackPanel Margin="0 10" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Click="OpenHyperlink" Tag="github" localization:Translator.Key="GITHUB" />
            <Button Click="OpenHyperlink" Tag="discord" localization:Translator.Key="DISCORD" />
            <Button Click="OpenHyperlink" Tag="email" localization:Translator.Key="EMAIL" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" TextAlignment="Center" localization:Translator.Key="CRASH_REPORT_CONTENT_INFO" />
    </StackPanel>
</Window>
